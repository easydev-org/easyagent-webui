# The webui is served by an aggregating Caddy that is SAME-ORIGIN with the
# agent RPC: `/` serves the static build, `/agent.v1.*` is reverse-proxied to
# the agent over h2c. This is why the browser needs only a token — the API base
# is always this page's own origin.
#
# AGENT_UPSTREAM IS REQUIRED. There is no default, on purpose — and the requirement is enforced by
# `tool/entrypoint.sh`, NOT by this file.
#
# `{$AGENT_UPSTREAM}` expands to an EMPTY string when the variable is unset, and Caddy accepts that:
# it starts, serves /srv, and answers 502 on every /agent.v1.* request. So a Caddyfile with no
# default does not fail — it fails SILENTLY, which is how the old default behaved too.
#
# There used to be a default: a cluster name from whichever environment built the image. A
# deployment that did not set the variable came up HEALTHY, because static assets are local, and
# breakage appeared only at login, with the cause visible only in Caddy's log:
#     dial tcp: lookup standalone-agent.temp.svc.cluster.local: no such host
#
# The entrypoint now refuses to start without it, so the failure lands at deploy time. Set it to the
# in-cluster agent, e.g. `agent.dev.svc.cluster.local:80`.
:8080 {
	handle /healthz {
		respond "ok" 200
	}

	# Connect RPC (AgentService / AdminService) -> agent over cleartext HTTP/2.
	handle /agent.v1.* {
		reverse_proxy {$AGENT_UPSTREAM} {
			transport http {
				versions h2c
			}
		}
	}

	# Extension UIs, proxied so an iframe embedding one is SAME-ORIGIN with this app.
	#
	# WHY PROXY AT ALL: extension Services are ClusterIP, so the browser cannot reach them. Proxying
	# also means the iframe's own fetches carry this origin's cookies — with a cross-origin iframe the
	# extension UI would have to log in separately, and `allow-same-origin` would be meaningless.
	#
	# The prefix is passed through UNCHANGED (not `handle_path`): each extension's UISpec.Base is
	# "/ext/<id>", and it serves its assets at that path. Stripping it here would 404 every asset.
	#
	# ONE rule for every extension, keyed on the CONVENTION `<id>` -> Service `<id>-ext`.
	#
	# This is what makes the list self-registering: shipping a UI means deploying a Service named
	# `<id>-ext`, and `/ext/<id>/` starts working with no change here. The alternative — one `handle`
	# per extension — needs a webui rebuild and redeploy for every new UI, which is exactly the
	# coupling a convention removes.
	#
	# Caddy allows placeholders in a non-URL upstream (a port is then required, which `:8080` is).
	# Such an upstream is "dynamically static": resolved per request, so a Service that appears later
	# is picked up without a reload. One that is absent answers 502 naming the host, which is the
	# right failure — it says which name was looked up.
	#
	# `[a-z0-9-]+` is deliberate: the capture becomes a HOSTNAME. Allowing dots or slashes would let
	# a crafted path address something other than an extension Service.
	@extUI path_regexp ext ^/ext/([a-z0-9-]+)(/.*)?$
	handle @extUI {
		reverse_proxy {re.ext.1}-ext.dev.svc.cluster.local:8080
	}

	# Static SPA with client-side routing fallback.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
