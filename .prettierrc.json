{
  "$schema": "https://json.schemastore.org/prettierrc",
  "plugins": ["prettier-plugin-svelte"],
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    }
  ],
  "arrowParens": "avoid"
}
