{
  "name": "easyagent-webui",
  "version": "0.4.21",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "vite build",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check:types": "tsc --noEmit",
    "dev": "vite",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "format:fix": "biome check --write .",
    "format:svelte": "prettier --check \"src/**/*.svelte\"",
    "format:svelte:fix": "prettier --write \"src/**/*.svelte\"",
    "lint": "biome lint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@easydev-org/ext-ui": "^0.3.0",
    "@lucide/svelte": "^1.42.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.12",
    "pdfjs-dist": "^6.3.289",
    "pptx-preview": "^1.0.7",
    "svelte": "^5.56.10",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "thumbhash": "^0.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
