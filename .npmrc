# @easydev-org/* comes from GitHub Packages, not npmjs. Everything else is public.
#
# THE TOKEN IS READ FROM THE ENVIRONMENT, never committed: a committed read:packages token has been
# revoked by secret scanning before, and every later install in that repository failed because of it.
@easydev-org:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
